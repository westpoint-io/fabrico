---
// A running board on a page: <Board name="demo_scene" />. The name is checked against the board
// files under examples/boards/ while the site builds, and a wrong or missing name fails the build.
// The board's poster sits inside the element, so a reader without JavaScript sees the board's end
// state, and the element's own shadow root replaces it once the embed script defines the element.
import { boardIdsOf, resolveBoard, type KnownBoard } from '../lib/boards.ts';

interface Props {
  name?: string;
  height?: number;
  noCode?: boolean;
  order?: 'forward' | 'reversed';
}

const { name, height, noCode, order } = Astro.props;
const page = `site/${Astro.locals.starlightRoute.entry.filePath}`;

// Every board file on disk, by repo path. Only the keys matter here.
const files = import.meta.glob('../../../examples/boards/**/*.board.ron', { query: '?raw', import: 'default', eager: true });
const ids = boardIdsOf(Object.keys(files).map((key) => key.replace(/^(\.\.\/)+/, '')));

// Titles and poster alt text, written by frontend/scripts/build-site-assets.ts. Read through a
// glob so a missing file reaches the check below instead of failing on the import.
type BoardsFile = { boards: { id: string; posterAlt: string }[] };
const generated = import.meta.glob<BoardsFile>('../generated/boards.json', { import: 'default', eager: true });
const info = new Map((Object.values(generated)[0]?.boards ?? []).map((b) => [b.id, b.posterAlt]));

const known: KnownBoard[] = ids.map((id) => {
  const alt = info.get(id);
  if (alt === undefined) {
    throw new Error(
      `[Board] examples/boards/ has a board with id "${id}", and site/src/generated/boards.json has no entry for it. ` +
        'Build the site with scripts/build-site.sh, which writes that file.',
    );
  }
  return { id, posterAlt: alt };
});

const board = resolveBoard(name, page, known);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="fab-board-slot not-content">
  <fabrico-board name={board.id} height={height} no-code={noCode ? '' : undefined} order={order}>
    <img
      src={`${base}/boards/${board.id}.png`}
      alt={board.posterAlt}
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </fabrico-board>
</div>

<script>
  // A processed script: Astro bundles it and adds it to a page once, however many boards the page
  // has. An inline script would run once per board and define the element twice, which throws.
  const script = document.createElement('script');
  script.src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/embed/fabrico-board.js`;
  document.head.append(script);
</script>

<style>
  .fab-board-slot {
    margin-block: 2rem;
  }
  .fab-board-slot img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
