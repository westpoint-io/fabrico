{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabrico",
  "version": "0.1.0",
  "identifier": "dev.fabrico.app",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend" },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fabrico",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/48x48.png",
      "icons/32x32.png",
      "icons/24x24.png",
      "icons/16x16.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend/src/assets/fonts/NOTICE.md": "attribution/NOTICE.md",
      "../../frontend/src/assets/fonts/OFL-1.1-MartianMono.txt": "attribution/OFL-1.1-MartianMono.txt",
      "../../frontend/src/assets/fonts/OFL-1.1-Sono.txt": "attribution/OFL-1.1-Sono.txt"
    }
  }
}
