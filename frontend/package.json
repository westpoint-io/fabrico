{
  "name": "fabrico-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "Fabrico renderer - Vite + React 19 + PixiJS v8 (browser-first, Tauri-wrapped)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:live": "rm -f test-results/live-report.json && cargo build -p fabrico-host --example dev_render_server && playwright test --config=playwright.live.config.ts",
    "perf:capture": "cargo build -p fabrico-host --example dev_render_server && node scripts/perf-capture.ts",
    "lint:svg": "node scripts/lint-svg.ts",
    "build:mark-sheet": "node scripts/build-mark-sheet.ts",
    "capture:mark-evidence": "node scripts/capture-mark-evidence.ts",
    "capture:lockup-hero": "node scripts/capture-lockup-hero.ts",
    "check:mark-craft": "node scripts/mark-craft.ts",
    "build:lockup": "node scripts/build-lockup.ts",
    "build:header-cut": "node scripts/build-header-cut.ts",
    "build:icons": "node scripts/build-icons.ts",
    "check:board": "bash scripts/check-board-structure.sh",
    "check:neutrality": "bash ../scripts/check-neutrality.sh"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "fontkit": "2.0.4",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wawoff2": "2.0.1"
  }
}
