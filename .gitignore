/target
**/*.rs.bk

# Frontend (Phase 07, Vite app — NOT a cargo member)
frontend/node_modules
frontend/dist
# The read-only board bundle, its test pages and the offline examples file (build outputs).
frontend/dist-embed/
frontend/dist-examples/
# The docs site's install, its build outputs, and the files its build copies or writes from the
# embed build and the app's skin. scripts/build-site.sh makes all of them.
site/node_modules/
site/dist/
site/dist-fixtures/
site/.astro/
site/public/embed/
site/public/boards/
site/public/fonts/
site/src/styles/generated/
site/src/generated/boards.json
site/src/assets/generated/

# ts-rs generated TS bindings (07-01 export target; regenerated on `cargo test`)
crates/fabrico-protocol/bindings/

# Tauri-build generated ACL/permission schemas (07-08; regenerated on `cargo build`)
crates/fabrico-app/gen/

# Phase 13 — Playwright e2e run artifacts (TEST-04, 13-04) + insta pending snaps.
# NB: do NOT ignore crates/fabrico-scenario/fixtures/ or snapshots/ — those are
# the committed golden corpus; only the *.snap.new pending review files are noise.
frontend/test-results/
frontend/playwright-report/
# A lesson walk shard's blob report, which CI merges in its walk verdict job.
frontend/blob-report/
crates/fabrico-scenario/**/*.snap.new

# Dev-server logs from the hand-started live-e2e path (plan 66-01). The
# frontend half is already covered by frontend/.gitignore; the dev_render_server is
# started from the repo root and writes here.
.srv-*.log

# The maintainer's private planning checkout: a separate repository cloned into this
# working tree. It is never part of this repository, and
# scripts/check-no-private-residue.sh allows these three lines here and nowhere else.
.planning/
CLAUDE.md
.claude/
