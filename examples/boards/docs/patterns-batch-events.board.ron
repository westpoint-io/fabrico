// A docs board for the pattern page Batch events into groups of N. One Source gets seven webhooks,
// 20 ticks apart, each an item with an id from 1 to 7, and its belt carries each item into a
// Factory. The code adds each item to a batch it keeps in ctx.state. While the batch holds fewer
// than 3 items, the run stores it and emits nothing. The run that brings the third item empties
// the batch and emits one item holding all three, in the order they arrived. A belt carries each
// combined item to a Debug Sink, so the Sink logs two items for items 1 to 6. Item 7 starts a new
// batch, and no more items come, so it stays in the Factory's state to the end of the run. The
// code never throws, so the Factory's Fault port, on its bottom middle cell facing south, stays
// undocked. The run makes no outbound call.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 10 commands and the history seal end the boot on tick 11.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Batch events into groups of N",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, Debug by default
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3: source -> factory
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4: factory -> sink
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// send one item for every 3 that come in
export default function (input, ctx) {
  const batch = ctx.state.batch || [];
  batch.push(input);
  if (batch.length < 3) {
    ctx.state.batch = batch;
    return;
  }
  ctx.state.batch = [];
  ctx.emit(0, { items: batch });
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"id":1}"#)),
        At(tick: 60, input: Webhook(source: 0, body: r#"{"id":2}"#)),
        At(tick: 80, input: Webhook(source: 0, body: r#"{"id":3}"#)),
        At(tick: 100, input: Webhook(source: 0, body: r#"{"id":4}"#)),
        At(tick: 120, input: Webhook(source: 0, body: r#"{"id":5}"#)),
        At(tick: 140, input: Webhook(source: 0, body: r#"{"id":6}"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"id":7}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63,...]; no effect before step_ends_on=125
        Caption(tick: 63, highlight: 1, text: "The Factory collects items in its state and sends one combined item for every 3. Item 1 is the first, so the Factory keeps it and sends nothing."),
        // Measured: h1 Factory WORKING[...,103,...]; effect step_ends_on=125 DEBUG from=h2 {"items":[{"id":1},{"id":2},{"id":3}]}
        Caption(tick: 103, highlight: 1, text: "Item 3 fills the batch, so the Factory sends items 1, 2 and 3 on as one item and starts an empty batch."),
        // Measured: h1 Factory WORKING[...,163,...]; effect step_ends_on=185 DEBUG from=h2 {"items":[{"id":4},{"id":5},{"id":6}]}
        Caption(tick: 163, highlight: 1, text: "Item 6 fills the second batch, so the Factory sends items 4, 5 and 6 on as one item."),
        // Measured: h1 Factory WORKING[...,183]; no effect after step_ends_on=185; end_tick=260 state={"batch":[{"id":7}]}
        Caption(tick: 183, highlight: 1, text: "Item 7 starts a new batch. No more items come, so it waits in the Factory's state and never leaves."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 260,
)
