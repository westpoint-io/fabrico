// The third step of the first-factory tutorial: the step 2 board, with code in the Factory. The code
// adds a greeting field to each item and sends it out, and the Debug Sink records the changed item.
// The Factory's Fault port, on its bottom middle cell facing south, stays undocked; the code never
// throws, so nothing goes there. The run makes no outbound call.
//
//   row 8:   SOURCE 0 -b3-> FACTORY 2 -b4-> SINK 1
//
// Handles mint in command order: the Source 0, the Sink 1, the Factory 2, then the belts 3 and 4.
// The 10 commands and the history seal end the boot on tick 11.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "First factory, step 3",
    seed: 98,
    commands: [
        Place(kind: 0, cell_x: 9, cell_y: 8),       // 0: SOURCE, a webhook trigger by default
        Place(kind: 7, cell_x: 19, cell_y: 8),       // 1: SINK, Debug by default
        Place(kind: 2, cell_x: 13, cell_y: 7),       // 2: FACTORY, 3x3
        DrawBelt(cells: [(10, 8), (11, 8), (12, 8)]),  // 3: source -> factory
        DrawBelt(cells: [(16, 8), (17, 8), (18, 8)]),  // 4: factory -> sink
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 2, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 2, port: 1),
        Dock(belt: 4, endpoint: Head, node: 1, port: 0),
        Configure(node: 2, config: Factory(source: r#"// add a greeting to each item
export default function (input, ctx) {
  input.greeting = "hello";
  ctx.emit(0, input);
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order":1}"#)),
        At(tick: 100, input: Webhook(source: 0, body: r#"{"order":2}"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"order":3}"#)),
    ],
    captions: [
        Caption(tick: 63, highlight: 2, text: "The Factory runs your code on this item, adds the greeting field and sends it out."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 260,
)
