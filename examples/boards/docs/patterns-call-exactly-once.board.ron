// A docs board for the pattern page Call an API exactly once. One Source gets one webhook, an
// order with an id and a total. A belt carries it into a Factory, whose code builds a charge for
// that order. A second belt carries the charge to an HTTP Sink, which sends it once as a POST to
// its URL. The executor below answers that URL after 20 ticks, so the board never reaches a
// network. The board shows one call going out and one answer coming back.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2, HTTP POST to https://example.com/charges
//
// The Factory's and the Sink's Fault ports stay undocked. The code never throws and the call gets
// its reply well inside the Sink's deadline, so nothing faults.
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 11 commands and the history seal end the boot on tick 12.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Call an API exactly once",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, set to HTTP below
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// charge the card for this order
export default function (input, ctx) {
  ctx.emit(0, { order: input.id, amount: input.total });
}"#)),
        Configure(node: 2, config: Sink(target: Http(url: "https://example.com/charges", method: Post))),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"id":1,"total":30}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63]; the item it sends on reaches the Sink as
        // {"order":1,"amount":30}.
        Caption(tick: 63, highlight: 1, text: "The Factory takes the order and builds one charge for it, with the order id and the amount."),
        // Measured: effect step_ends_on=85, HTTP Post https://example.com/charges, the only effect
        // on the board (effects=1); the log row reads t84 POST https://example.com/charges ok.
        Caption(tick: 85, highlight: 2, text: "The HTTP Sink sends the charge to its URL as a POST. This is the one call the board makes."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: [
        Rule(url_prefix: "https://example.com/charges", outcome: Reply(after_ticks: 20)),
    ]),
    view: View(fit: Board),
    end_tick: 200,
)
