// A docs board for the Source. A Source makes an item in one of two ways: from each webhook it is
// sent, or on a timer. The top Source keeps the default webhook trigger and gets three webhooks
// from the script. The bottom Source is set to a timer and makes an item every 60 ticks with no
// input at all. Each Source has its own belt into a Debug Sink, so the run makes no outbound call.
//
//   row 2:   SOURCE 0 (webhook) -b4-> SINK 2
//   row 5:   SOURCE 1 (timer)   -b5-> SINK 3
//
// Handles mint in command order: the Sources 0 and 1, the Sinks 2 and 3, then the belts 4 and 5.
// The 11 commands and the history seal end the boot on tick 12.
//
// machine_kind u8 legend: SOURCE=0, SINK=7. Dock `port` is the catalog port index: SOURCE Out=0;
// SINK In=0.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Source",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE, webhook trigger by default
        Place(kind: 0, cell_x: 1, cell_y: 5),        // 1: SOURCE, set to a timer below
        Place(kind: 7, cell_x: 6, cell_y: 2),        // 2: SINK, Debug by default
        Place(kind: 7, cell_x: 6, cell_y: 5),        // 3: SINK
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2), (5, 2)]),                // 4
        DrawBelt(cells: [(2, 5), (3, 5), (4, 5), (5, 5)]),                // 5
        Dock(belt: 4, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Dock(belt: 5, endpoint: Tail, node: 1, port: 0),
        Dock(belt: 5, endpoint: Head, node: 3, port: 0),
        Configure(node: 1, config: Source(trigger: Timer(interval_ticks: 60))),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order":1}"#)),
        At(tick: 110, input: Webhook(source: 0, body: r#"{"order":2}"#)),
        At(tick: 230, input: Webhook(source: 0, body: r#"{"order":3}"#)),
    ],
    captions: [
        Caption(tick: 41, highlight: 0, text: "A webhook reached the top Source, and the Source turned its body into an item on the belt."),
        Caption(tick: 61, highlight: 1, text: "The bottom Source is on a timer. It made this item on its own, with no webhook."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 300,
)
