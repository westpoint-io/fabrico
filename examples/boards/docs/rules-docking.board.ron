// A docs board that unlinks, docks and turns a machine while it runs. A Source on a timer puts an
// item on its belt every 8 ticks, and the belt carries each one to a Debug Sink. On tick 80 a
// scripted Unlink takes the belt's end off the Sink, and items wait at the end of the belt. On tick
// 140 a Dock joins it again and the waiting items flow in. On tick 220 a Rotate turns the Sink a
// quarter-turn clockwise, so its input faces north, away from the belt's end, and the turn undocks
// the belt. On tick 280 a Rotate turns it back, so its input faces the belt's end again, and the turn
// docks the belt by itself. The run makes no outbound call.
//
//   row 2:   SOURCE 0 -b2-> SINK 1
//
// Handles mint in command order: the Source 0, the Sink 1, then the belt 2. The 6 commands and the
// history seal end the boot on tick 7.
//
// machine_kind u8 legend: SOURCE=0, SINK=7. Dock and Unlink `port` is the catalog port index:
// SOURCE Out=0; SINK In=0.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Docking, unlinking and turning",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 7, cell_x: 7, cell_y: 2),        // 1: SINK, Debug by default
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2), (5, 2), (6, 2)]),        // 2
        Dock(belt: 2, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 2, endpoint: Head, node: 1, port: 0),
        Configure(node: 0, config: Source(trigger: Timer(interval_ticks: 8))),
    ],
    script: [
        At(tick: 80, input: Edit(Unlink(belt: 2, endpoint: Head, node: 1, port: 0))),
        At(tick: 140, input: Edit(Dock(belt: 2, endpoint: Head, node: 1, port: 0))),
        At(tick: 220, input: Edit(Rotate(node: 1, ccw: false))),
        At(tick: 280, input: Edit(Rotate(node: 1, ccw: true))),
    ],
    captions: [
        // Measured: the link count drops from 2 to 1 on 81 and 221 and goes back to 2 on 141 and
        // 281. The belt holds 4 or 5 items while it flows and fills to 12 while it is undocked.
        Caption(tick: 81, highlight: 1, text: "A scripted Unlink took the belt's end off the Sink on tick 80. Items stop at the end of the belt and wait there."),
        Caption(tick: 141, highlight: 1, text: "A Dock on tick 140 joined the belt's end to the Sink's input again, and the waiting items move in."),
        Caption(tick: 221, highlight: 1, text: "A Rotate on tick 220 turned the Sink a quarter-turn clockwise. Its input now faces up, away from the belt, so the turn undocked the belt."),
        Caption(tick: 281, highlight: 1, text: "A Rotate on tick 280 turned the Sink back. Its input faces the belt's end again, so the turn docked the belt by itself and items flow."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 360,
)
