// A docs board for the pattern page Split an array into items. One Source gets two order
// webhooks: A-1 lists three line items and A-2 lists two. A belt carries each order into a
// Factory, whose code emits one item for each line item, holding the order id, the sku and the
// quantity. A second belt carries the new items to a Debug Sink, which logs each one. The run
// makes no outbound call.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2
//
// The Factory's Fault port stays undocked. Each order has fewer line items than one run may emit
// on an output, and the code never throws, so nothing faults.
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 10 commands and the history seal end the boot on tick 11.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Split an array into items",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, Debug by default
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// one item for each line item in the order
export default function (input, ctx) {
  for (const line of input.items) {
    ctx.emit(0, {
      order: input.order,
      sku: line.sku,
      qty: line.qty,
    });
  }
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order":"A-1","items":[{"sku":"pen","qty":2},{"sku":"ink","qty":1},{"sku":"pad","qty":3}]}"#)),
        At(tick: 140, input: Webhook(source: 0, body: r#"{"order":"A-2","items":[{"sku":"pen","qty":5},{"sku":"pad","qty":1}]}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63-65,163-164] factory.faults=0.
        Caption(tick: 63, highlight: 1, text: "The Factory takes order A-1 and emits one item for each of its three line items; the first leaves at once and the other two follow one a tick."),
        // Measured: effect step_ends_on=85 DEBUG {"order":"A-1","sku":"pen","qty":2}.
        Caption(tick: 85, highlight: 2, text: "The Debug Sink logs the first line item of order A-1, a pen with a quantity of 2, as an item of its own."),
        // Measured: effect step_ends_on=89 DEBUG {"order":"A-1","sku":"pad","qty":3}.
        Caption(tick: 89, highlight: 2, text: "The Debug Sink logs the third line item, a pad with a quantity of 3, so the one webhook has become three items."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 260,
)
