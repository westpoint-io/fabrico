// The first step of the first-factory tutorial. One Source gets three webhooks, then a run of 35 two
// ticks apart near the end, and one long belt carries each item to a Debug Sink, which records it and
// sends nothing. The run fills the belt by the last tick, so the board's poster shows items moving.
// The nine empty cells the belt crosses are where the next step puts a Factory and two short belts.
// The run makes no outbound call.
//
//   row 8:   SOURCE 0 -b2 (nine cells)-> SINK 1
//
// Handles mint in command order: the Source 0, the Sink 1, then the belt 2.
// The 5 commands and the history seal end the boot on tick 6.
//
// machine_kind u8 legend: SOURCE=0, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; SINK In=0.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "First factory, step 1",
    seed: 98,
    commands: [
        Place(kind: 0, cell_x: 9, cell_y: 8),       // 0: SOURCE, a webhook trigger by default
        Place(kind: 7, cell_x: 19, cell_y: 8),       // 1: SINK, Debug by default
        DrawBelt(cells: [(10, 8), (11, 8), (12, 8), (13, 8), (14, 8), (15, 8), (16, 8), (17, 8), (18, 8)]), // 2
        Dock(belt: 2, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 2, endpoint: Head, node: 1, port: 0),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order":1}"#)),
        At(tick: 100, input: Webhook(source: 0, body: r#"{"order":2}"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"order":3}"#)),
        At(tick: 190, input: Webhook(source: 0, body: r#"{"order":4}"#)),
        At(tick: 192, input: Webhook(source: 0, body: r#"{"order":5}"#)),
        At(tick: 194, input: Webhook(source: 0, body: r#"{"order":6}"#)),
        At(tick: 196, input: Webhook(source: 0, body: r#"{"order":7}"#)),
        At(tick: 198, input: Webhook(source: 0, body: r#"{"order":8}"#)),
        At(tick: 200, input: Webhook(source: 0, body: r#"{"order":9}"#)),
        At(tick: 202, input: Webhook(source: 0, body: r#"{"order":10}"#)),
        At(tick: 204, input: Webhook(source: 0, body: r#"{"order":11}"#)),
        At(tick: 206, input: Webhook(source: 0, body: r#"{"order":12}"#)),
        At(tick: 208, input: Webhook(source: 0, body: r#"{"order":13}"#)),
        At(tick: 210, input: Webhook(source: 0, body: r#"{"order":14}"#)),
        At(tick: 212, input: Webhook(source: 0, body: r#"{"order":15}"#)),
        At(tick: 214, input: Webhook(source: 0, body: r#"{"order":16}"#)),
        At(tick: 216, input: Webhook(source: 0, body: r#"{"order":17}"#)),
        At(tick: 218, input: Webhook(source: 0, body: r#"{"order":18}"#)),
        At(tick: 220, input: Webhook(source: 0, body: r#"{"order":19}"#)),
        At(tick: 222, input: Webhook(source: 0, body: r#"{"order":20}"#)),
        At(tick: 224, input: Webhook(source: 0, body: r#"{"order":21}"#)),
        At(tick: 226, input: Webhook(source: 0, body: r#"{"order":22}"#)),
        At(tick: 228, input: Webhook(source: 0, body: r#"{"order":23}"#)),
        At(tick: 230, input: Webhook(source: 0, body: r#"{"order":24}"#)),
        At(tick: 232, input: Webhook(source: 0, body: r#"{"order":25}"#)),
        At(tick: 234, input: Webhook(source: 0, body: r#"{"order":26}"#)),
        At(tick: 236, input: Webhook(source: 0, body: r#"{"order":27}"#)),
        At(tick: 238, input: Webhook(source: 0, body: r#"{"order":28}"#)),
        At(tick: 240, input: Webhook(source: 0, body: r#"{"order":29}"#)),
        At(tick: 242, input: Webhook(source: 0, body: r#"{"order":30}"#)),
        At(tick: 244, input: Webhook(source: 0, body: r#"{"order":31}"#)),
        At(tick: 246, input: Webhook(source: 0, body: r#"{"order":32}"#)),
        At(tick: 248, input: Webhook(source: 0, body: r#"{"order":33}"#)),
        At(tick: 250, input: Webhook(source: 0, body: r#"{"order":34}"#)),
        At(tick: 252, input: Webhook(source: 0, body: r#"{"order":35}"#)),
        At(tick: 254, input: Webhook(source: 0, body: r#"{"order":36}"#)),
        At(tick: 256, input: Webhook(source: 0, body: r#"{"order":37}"#)),
        At(tick: 258, input: Webhook(source: 0, body: r#"{"order":38}"#)),
    ],
    captions: [
        Caption(tick: 111, highlight: 1, text: "The Debug Sink takes the first item off the belt and records it. It sends nothing."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 260,
)
