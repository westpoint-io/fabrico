// A docs board that faults on purpose with NoMatch. One Source gets two webhooks, and its belt
// carries each item to a Router with two routes and no default output. The first body starts with
// {"to":"a", so the first route sends it out the top output. The second body starts with
// {"to":"c", which matches neither route, and with no default the Router sends it out its Fault
// port as a NoMatch fault. A belt from the Fault port carries the fault to a Debug Sink, where it
// can be read. The run makes no outbound call.
//
//   row 0:                                                   +-b6-> SINK 2
//   row 1:                              ROUTER 1 Out (emit 2) -+
//   row 2:   SOURCE 0 -b5-> ROUTER 1 In
//   row 3:                              ROUTER 1 Out (emit 1) -+
//   row 4:                  ROUTER 1 Fault                   +-b7-> SINK 3
//   row 5:                       |
//   row 6:                       +-b8-------------------------> SINK 4   (the faults)
//
// The middle output (emit 0) has no belt: with no default, no item goes there.
//
// Handles mint in command order: the Source 0, the Router 1, the Sinks 2, 3 and 4, then the belts
// 5 to 8. The 18 commands and the history seal end the boot on tick 19.
//
// machine_kind u8 legend: SOURCE=0, ROUTER=5, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; ROUTER In=0, Outs 1, 2 and 3 (emit 0, 1 and 2, on its east rows 1, 2 and 0),
// Fault=4 (its bottom-left cell, facing south); SINK In=0. A route names its output by emit
// number, not by catalog index.
//
// Each route's `expect` is the UTF-8 bytes of a prefix at offset 0, written as a number list
// because RON has no byte strings: 123 34 116 111 34 58 34 97 34 is {"to":"a" and the second ends
// in 98 34 for {"to":"b".
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "A Router with no default",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 5, cell_x: 6, cell_y: 1),        // 1: ROUTER, 2x3
        Place(kind: 7, cell_x: 11, cell_y: 0),       // 2: SINK, Debug by default
        Place(kind: 7, cell_x: 11, cell_y: 4),       // 3: SINK
        Place(kind: 7, cell_x: 11, cell_y: 6),       // 4: SINK, gets the faults
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2), (5, 2)]),                          // 5
        DrawBelt(cells: [(8, 1), (9, 1), (9, 0), (10, 0)]),                         // 6
        DrawBelt(cells: [(8, 3), (9, 3), (9, 4), (10, 4)]),                         // 7
        DrawBelt(cells: [(6, 4), (6, 5), (6, 6), (7, 6), (8, 6), (9, 6), (10, 6)]), // 8
        Dock(belt: 5, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 5, endpoint: Head, node: 1, port: 0),
        Dock(belt: 6, endpoint: Tail, node: 1, port: 3),
        Dock(belt: 6, endpoint: Head, node: 2, port: 0),
        Dock(belt: 7, endpoint: Tail, node: 1, port: 2),
        Dock(belt: 7, endpoint: Head, node: 3, port: 0),
        Dock(belt: 8, endpoint: Tail, node: 1, port: 4),
        Dock(belt: 8, endpoint: Head, node: 4, port: 0),
        Configure(node: 1, config: Router(routes: [
            // {"to":"a"  -> emit 2, the top output
            ((offset: 0, expect: [123, 34, 116, 111, 34, 58, 34, 97, 34]), 2),
            // {"to":"b"  -> emit 1, the bottom output
            ((offset: 0, expect: [123, 34, 116, 111, 34, 58, 34, 98, 34]), 1),
        ], default: None)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"to":"a","order":1}"#)),
        At(tick: 100, input: Webhook(source: 0, body: r#"{"to":"c","order":2}"#)),
    ],
    captions: [
        Caption(tick: 71, highlight: 1, text: "This body starts with {\"to\":\"a\", so the first route sends it out the top output."),
        Caption(tick: 131, highlight: 1, text: "This body starts with {\"to\":\"c\" and matches neither route. With no default, the Router sends it out its Fault port as a NoMatch fault."),
        Caption(tick: 185, highlight: 4, text: "The fault reached the Sink at the end of the fault belt. It carries the item, so the Sink records the body the Router couldn't route."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 220,
)
