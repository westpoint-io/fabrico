// A docs board for the Sink. Two Sources each feed a belt into a Sink. The top Sink sends each
// item as an HTTP POST to its URL, and the executor below answers every call to that URL after
// 20 ticks, so the board never reaches a network. The bottom Sink is a Debug Sink, which only
// records each item. The reader sees both targets take items.
//
//   row 1:   SOURCE 0 -b4-> SINK 2, HTTP POST to https://example.com/orders
//   row 4:   SOURCE 1 -b5-> SINK 3, Debug
//
// Each Sink's Fault port, on its south side, stays undocked. Every call gets its reply well
// inside the Sink's deadline, so no item faults.
//
// Handles mint in command order: the Sources 0 and 1, the Sinks 2 and 3, then the belts 4 and 5.
// The 11 commands and the history seal end the boot on tick 12.
//
// machine_kind u8 legend: SOURCE=0, SINK=7. Dock `port` is the catalog port index: SOURCE
// Out=0; SINK In=0.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Sink",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 1),        // 0: SOURCE
        Place(kind: 0, cell_x: 1, cell_y: 4),        // 1: SOURCE
        Place(kind: 7, cell_x: 6, cell_y: 1),        // 2: SINK, set to HTTP below
        Place(kind: 7, cell_x: 6, cell_y: 4),        // 3: SINK, Debug by default
        DrawBelt(cells: [(2, 1), (3, 1), (4, 1), (5, 1)]),                // 4
        DrawBelt(cells: [(2, 4), (3, 4), (4, 4), (5, 4)]),                // 5
        Dock(belt: 4, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Dock(belt: 5, endpoint: Tail, node: 1, port: 0),
        Dock(belt: 5, endpoint: Head, node: 3, port: 0),
        Configure(node: 2, config: Sink(target: Http(url: "https://example.com/orders", method: Post))),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order":1}"#)),
        At(tick: 100, input: Webhook(source: 1, body: r#"{"note":"first"}"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"order":2}"#)),
    ],
    captions: [
        // Measured: the HTTP Sink sends on 71 and 191 and each reply arrives 20 ticks later; the
        // Debug Sink records its item on 131.
        Caption(tick: 71, highlight: 2, text: "The top Sink took this item and sent it as a POST to its URL. The script answers it 20 ticks later."),
        Caption(tick: 131, highlight: 3, text: "The bottom Sink is a Debug Sink. It recorded this item and sent nothing."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: [
        Rule(url_prefix: "https://example.com/orders", outcome: Reply(after_ticks: 20)),
    ]),
    view: View(fit: Board),
    end_tick: 260,
)
