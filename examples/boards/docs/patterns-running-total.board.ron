// A docs board for the pattern page Keep a running total per key. One Source gets four webhooks,
// each an order with a customer and an amount, and its belt carries each order into a Factory.
// The code keeps a total for each customer in ctx.state, adds the order's amount to that
// customer's total, and emits the customer with the new total. A belt carries each new item to a
// Debug Sink. ctx.state carries from one run to the next, so the totals grow across the four runs:
// ada's reach 30, 50 and 55, and bob's starts at 12. The code never throws, so the Factory's Fault
// port, on its bottom middle cell facing south, stays undocked. The run makes no outbound call.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 10 commands and the history seal end the boot on tick 11.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Keep a running total per key",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, Debug by default
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3: source -> factory
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4: factory -> sink
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// add each order to its customer's total
export default function (input, ctx) {
  const totals = ctx.state.totals || {};
  totals[input.customer] =
    (totals[input.customer] || 0) + input.total;
  ctx.state.totals = totals;
  ctx.emit(0, {
    customer: input.customer,
    total: totals[input.customer],
  });
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"customer":"ada","total":30}"#)),
        At(tick: 80, input: Webhook(source: 0, body: r#"{"customer":"bob","total":12}"#)),
        At(tick: 120, input: Webhook(source: 0, body: r#"{"customer":"ada","total":20}"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"customer":"ada","total":5}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63,...]; effect step_ends_on=85 DEBUG from=h2 {"customer":"ada","total":30}
        Caption(tick: 63, highlight: 1, text: "The Factory adds ada's first order to her total, which starts at 30, and sends the new total on to the Debug Sink."),
        // Measured: h1 Factory WORKING[...,103,...]; effect step_ends_on=125 DEBUG from=h2 {"customer":"bob","total":12}
        Caption(tick: 103, highlight: 1, text: "Bob has no total yet, so the Factory starts his total at the amount of his first order, 12. Ada's total stays at 30."),
        // Measured: h1 Factory WORKING[...,183]; effect step_ends_on=205 DEBUG from=h2 {"customer":"ada","total":55}; state={"totals":{"ada":55,"bob":12}}
        Caption(tick: 183, highlight: 1, text: "Ada's third order adds 5 to her total of 50, so the Factory sends a total of 55 for ada."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 260,
)
