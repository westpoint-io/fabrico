// A docs board for the pattern page Validate webhook payloads. One Source gets four webhooks, and
// its belt carries each body into a Factory with two outputs. The code passes an order when its id
// and total are numbers and the total is above 0: good orders leave by output 0 to the good orders
// Debug Sink, and bad ones leave by output 1 to a quarantine Debug Sink, where they can be read.
// The third body isn't JSON. The Factory parses each body before the code runs, so that body makes
// the run fault with FactoryError, and the fault leaves by the Fault port. A belt from the Fault
// port carries it straight to a dead letter Debug Sink. The fault holds the parse error message,
// not the body. The run makes no outbound call.
//
//   row 1:                                  +-b6-> SINK 2   (good orders)
//   row 2:   SOURCE 0 -b5-> FACTORY 1 emit 0 -+
//   row 3:                  FACTORY 1 emit 1 -+
//   row 4:                  (Fault)         +-b7-> SINK 3   (quarantine)
//   row 5:                     |
//   row 6:                     |
//   row 7:                     +-b8----------> SINK 4   (dead letters)
//
// The Factory starts with one output. AddPort gives it a second one, the way + Add output does in
// the inspector: role 1 is an output, side 1 is east, medium 0 is a belt. The new output is catalog
// port 3 and emit 1, and it seats below the first output, at world cell (7,3). The Fault port sits
// on the Factory's bottom middle cell, facing south, so its belt starts at (6,4).
//
// Handles mint in command order: the Source 0, the Factory 1, the Sinks 2 to 4, then the belts 5
// to 8. The 19 commands and the history seal end the boot on tick 20.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1 (emit 0), Fault=2, the added Out=3 (emit 1); SINK In=0.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Validate webhook payloads",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 1),       // 2: SINK, Debug, good orders
        Place(kind: 7, cell_x: 11, cell_y: 4),       // 3: SINK, Debug, quarantine
        Place(kind: 7, cell_x: 11, cell_y: 7),       // 4: SINK, Debug, dead letters
        AddPort(node: 1, role: 1, side: 1, medium: 0),
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),                                         // 5
        DrawBelt(cells: [(8, 2), (9, 2), (9, 1), (10, 1)]),                                // 6
        DrawBelt(cells: [(8, 3), (9, 3), (9, 4), (10, 4)]),                                // 7
        DrawBelt(cells: [(6, 4), (6, 5), (6, 6), (6, 7), (7, 7), (8, 7), (9, 7), (10, 7)]), // 8
        Dock(belt: 5, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 5, endpoint: Head, node: 1, port: 0),
        Dock(belt: 6, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 6, endpoint: Head, node: 2, port: 0),
        Dock(belt: 7, endpoint: Tail, node: 1, port: 3),
        Dock(belt: 7, endpoint: Head, node: 3, port: 0),
        Dock(belt: 8, endpoint: Tail, node: 1, port: 2),
        Dock(belt: 8, endpoint: Head, node: 4, port: 0),
        Configure(node: 1, config: Factory(source: r#"// good orders go on, bad ones to quarantine
export default function (input, ctx) {
  const ok = typeof input.id === "number"
    && typeof input.total === "number"
    && input.total > 0;
  ctx.emit(ok ? 0 : 1, input);
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"id":1,"total":30}"#)),
        At(tick: 80, input: Webhook(source: 0, body: r#"{"id":2,"total":-5}"#)),
        At(tick: 120, input: Webhook(source: 0, body: r#"order 3, total 12"#)),
        At(tick: 160, input: Webhook(source: 0, body: r#"{"id":4,"total":12}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63,...]; effect step_ends_on=93 DEBUG from=h2 {"id":1,"total":30}
        Caption(tick: 63, highlight: 1, text: "The Factory checks order 1. Its id and total are numbers and the total is above 0, so the Factory sends it out of output 0 to the good orders Debug Sink."),
        // Measured: h1 Factory WORKING[...,103,...]; effect step_ends_on=133 DEBUG from=h3 {"id":2,"total":-5}
        Caption(tick: 103, highlight: 1, text: "Order 2 has a total below 0, so the Factory sends it out of output 1 to the quarantine Debug Sink, where it can be read."),
        // Measured: FAULTED tick=143 node=h1
        Caption(tick: 143, highlight: 1, text: "The third body isn't JSON, so the Factory faults before its code runs and sends a FactoryError fault out of its Fault port."),
        // Measured: effect step_ends_on=205 DEBUG from=h4 fault_end=true | FAULT FactoryError payload="Error: unexpected token: 'order'..."
        Caption(tick: 205, highlight: 4, text: "The FactoryError fault reached the dead letter Debug Sink. It holds the parse error message, not the body that was sent."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 300,
)
