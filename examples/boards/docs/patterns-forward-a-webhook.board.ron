// A docs board for the pattern page Forward a webhook to another URL. One Source gets two
// webhooks, each an order with an id, a total and a card number. A belt carries each item into a
// Factory, whose code keeps the id and the total and drops the card number. A second belt carries
// the smaller item to an HTTP Sink, which sends it as a POST to its URL. The executor below
// answers every call to that URL after 20 ticks, so the board never reaches a network.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2, HTTP POST to https://example.com/orders
//
// The Factory's and the Sink's Fault ports stay undocked. The code never throws and every call
// gets its reply well inside the Sink's deadline, so nothing faults.
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 11 commands and the history seal end the boot on tick 12.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Forward a webhook to another URL",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, set to HTTP below
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// keep the fields the next service reads
export default function (input, ctx) {
  ctx.emit(0, { id: input.id, total: input.total });
}"#)),
        Configure(node: 2, config: Sink(target: Http(url: "https://example.com/orders", method: Post))),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"id":1,"total":30,"card":"4242"}"#)),
        At(tick: 120, input: Webhook(source: 0, body: r#"{"id":2,"total":75,"card":"1881"}"#)),
    ],
    captions: [
        // Measured: the Factory works on 63 and 143.
        Caption(tick: 63, highlight: 1, text: "The Factory takes the first order, keeps its id and total, drops the card number and sends the smaller item on."),
        // Measured: the HTTP Sink sends {"id":1,"total":30} on 85 and {"id":2,"total":75} on 165.
        Caption(tick: 85, highlight: 2, text: "The HTTP Sink sends the smaller item to its URL as a POST, with no card number in the body, and the script answers it 20 ticks later."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: [
        Rule(url_prefix: "https://example.com/orders", outcome: Reply(after_ticks: 20)),
    ]),
    view: View(fit: Board),
    end_tick: 260,
)
