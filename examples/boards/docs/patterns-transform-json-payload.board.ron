// A docs board for the pattern page Transform a JSON payload. One Source gets two webhooks, each
// an order whose body names its id order_id and carries a debug flag. A belt carries each item
// into a Factory, whose code renames order_id to orderId, adds a currency field and leaves the
// debug flag out. A second belt carries the new item to a Debug Sink, which logs it. The run makes
// no outbound call.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4-> SINK 2
//
// The Factory's Fault port stays undocked. Both bodies are JSON and the code never throws, so
// nothing faults.
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3 and 4.
// The 10 commands and the history seal end the boot on tick 11.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0. In the code, ctx.emit(0, ...) sends on
// the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Transform a JSON payload",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),        // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),        // 1: FACTORY, 3x3
        Place(kind: 7, cell_x: 11, cell_y: 2),       // 2: SINK, Debug by default
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),   // 3
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),  // 4
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 2, port: 0),
        Configure(node: 1, config: Factory(source: r#"// rename one field, add one, drop one
export default function (input, ctx) {
  ctx.emit(0, {
    orderId: input.order_id,
    total: input.total,
    currency: "EUR",
  });
}"#)),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"order_id":7,"total":30,"debug":true}"#)),
        At(tick: 120, input: Webhook(source: 0, body: r#"{"order_id":8,"total":12,"debug":false}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63,143] factory.faults=0.
        Caption(tick: 63, highlight: 1, text: "The Factory reshapes the first order: it renames the order id field, adds a currency of EUR, leaves out the debug flag and sends the new item on."),
        // Measured: effect step_ends_on=85 DEBUG {"orderId":7,"total":30,"currency":"EUR"}.
        Caption(tick: 85, highlight: 2, text: "The Debug Sink logs the new item with three fields, orderId 7, total 30 and currency EUR, and no debug flag."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: []),
    view: View(fit: Board),
    end_tick: 240,
)
