// A docs board for the pattern page Rate limit with belt pace. One Source gets six webhooks on the
// same tick. A Factory turns each into the request body a mail service expects. Its output belt,
// at the usual pace, is the queue: its head joins the tail of a two-tile belt set to the slowest
// pace, and that slow belt feeds an HTTP Sink. The slow belt hands over one item every 20 ticks,
// so the calls go out 20 ticks apart however fast the webhooks came. The executor below answers
// every call to the Sink's URL after 5 ticks, so the board never reaches a network.
//
//   row 2:   SOURCE 0 -b3-> FACTORY 1 -b4 (the queue)-> b5 (2 tiles, slowest pace) -> SINK 2, HTTP POST
//
// The queue belt is joined to the slow belt, not docked to a machine, so it hands its items
// straight across and the slow belt's start never holds a waiting item. Every waiting item is in
// a slot, where the board draws it. The join names the slow belt as the node and its Tail as port
// 0, the way Join two belts does in the app.
//
// Six webhooks keep the Source's backlog at 5, under its cap, so the Source drops nothing. The
// Factory's and the Sink's Fault ports stay undocked. The code never throws and every call gets
// its reply well inside the Sink's deadline, so nothing faults.
//
// Handles mint in command order: the Source 0, the Factory 1, the Sink 2, then the belts 3, 4 and
// 5. The 14 commands and the history seal end the boot on tick 15.
//
// machine_kind u8 legend: SOURCE=0, FACTORY=2, SINK=7. Dock `port` is the catalog port index:
// SOURCE Out=0; FACTORY In=0, Out=1, Fault=2; SINK In=0; a belt as the node, Tail=0. In the
// code, ctx.emit(0, ...) sends on the Factory's first output, catalog port 1.
//
// Format 2 adds two fields a page reads and the core never does: `title`, the name a page shows,
// and `captions`, the ticks a viewer pauses on, each with the machine it highlights and one
// sentence about what the board does on that tick.
Board(
    format: 2,
    title: "Rate limit with belt pace",
    seed: 97,
    commands: [
        Place(kind: 0, cell_x: 1, cell_y: 2),                    // 0: SOURCE
        Place(kind: 2, cell_x: 5, cell_y: 1),                    // 1: FACTORY In (5,2) Out (7,2)
        Place(kind: 7, cell_x: 13, cell_y: 2),                   // 2: SINK, set to HTTP below
        DrawBelt(cells: [(2, 2), (3, 2), (4, 2)]),               // 3
        DrawBelt(cells: [(8, 2), (9, 2), (10, 2)]),              // 4: the queue, usual pace
        DrawBelt(cells: [(11, 2), (12, 2)]),                     // 5: the paced belt
        Dock(belt: 3, endpoint: Tail, node: 0, port: 0),
        Dock(belt: 3, endpoint: Head, node: 1, port: 0),
        Dock(belt: 4, endpoint: Tail, node: 1, port: 1),
        Dock(belt: 4, endpoint: Head, node: 5, port: 0),
        Dock(belt: 5, endpoint: Head, node: 2, port: 0),
        Configure(node: 5, config: Belt(ticks_per_slot: 20)),
        Configure(node: 1, config: Factory(source: r#"// the request body the service expects
export default function (input, ctx) {
  ctx.emit(0, { email: input.email });
}"#)),
        Configure(node: 2, config: Sink(target: Http(url: "https://example.com/mail", method: Post))),
    ],
    script: [
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"a@example.com"}"#)),
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"b@example.com"}"#)),
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"c@example.com"}"#)),
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"d@example.com"}"#)),
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"e@example.com"}"#)),
        At(tick: 40, input: Webhook(source: 0, body: r#"{"email":"f@example.com"}"#)),
    ],
    captions: [
        // Measured: h1 Factory WORKING[63,65,67,69,71,73]; h0 Source WORKING[41-46] max_pending=5.
        Caption(tick: 63, highlight: 1, text: "Six webhooks arrived on one tick, and the Factory turns the first into a request body. A slow belt will space the calls 20 ticks apart."),
        // Measured: effect step_ends_on=221 HTTP https://example.com/mail a@example.com; t221 b5:5+0.
        Caption(tick: 221, highlight: 2, text: "The HTTP Sink makes its first call. The slow belt in front of it hands over one request body every 20 ticks."),
        // Measured: effect step_ends_on=241 HTTP https://example.com/mail b@example.com; t241 b5:4+0.
        Caption(tick: 241, highlight: 2, text: "The HTTP Sink makes the next call, 20 ticks after the first. The other four wait in order on the slow belt."),
    ],
    executor: Executor(default: Reply(after_ticks: 1), rules: [
        Rule(url_prefix: "https://example.com/mail", outcome: Reply(after_ticks: 5)),
    ]),
    view: View(fit: Board),
    end_tick: 400,
)
